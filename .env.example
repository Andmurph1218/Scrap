# Wago login (obrigatório para scrape com preço autenticado)
WAGO_USER=
WAGO_PASS=

# Markup: venda = (custo + IPI) / MARGIN_DIVISOR
MARGIN_DIVISOR=0.6

# Nuvemshop (obrigatório para `photos`)
NUVEMSHOP_CLIENT_ID=37416
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_USER_AGENT=JHSHOPPING (contato@jhshopping.com.br)

# Motor de Categorias (taxonomia) — IA agnóstica
# IA_PROVIDER: gemini | openai | anthropic | devin_api | devin_assistido | nenhum (vazio = auto pela chave presente)
IA_PROVIDER=
IA_MODEL=
IA_FALLBACK=devin_api
IA_LOTE=25
IA_TIMEOUT=60
IA_MAX_PRODUTOS_POR_EXECUCAO=2000
# Ritmo máximo de chamadas por minuto (evita estourar o limite do plano). Ao esgotar a cota,
# o processamento pausa, avisa o operador e continua quando o plano liberar novo uso.
IA_RPM=10
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEVIN_API_KEY=
TAXONOMIA_LIMIAR_CONFIANCA=0.85

# Mercado Livre (obrigatório para `ml-map` e `ml-templates`)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
ML_ACCESS_TOKEN=
